# Copy to .env.local and fill in real values. Never commit .env.local
# itself (already gitignored via .env*). Values below are placeholders.

# --- SEO ---
# Unset/anything but "true" = every route sends X-Robots-Tag: noindex,
# nofollow (see next.config.ts). Only set to "true" in Vercel's env vars
# on the one deployment that should actually be searchable.
ALLOW_INDEXING=

# --- Backend API ---
NEXT_PUBLIC_API_URL=https://swales-backend.vercel.app/api

# --- App URLs ---
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# Read internally by next-auth itself, not via an explicit process.env
# reference in this codebase — still required.
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (NextAuth) ---
# Same Google OAuth client as swales-services and the GOOGLE_CLIENT_ID
# configured on the swales-backend side — the id_token this issues has to
# verify against that same client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=

# --- CoffeePopup donation links (Stripe payment links) ---
# All 4 are referenced in components/CoffeePopup.tsx. Only
# NEXT_PUBLIC_STRIPE_LINK_CUSTOM was set as of the 2026-08-23 hygiene pass —
# the $3/$5/$10 preset buttons resolve to undefined without these.
NEXT_PUBLIC_STRIPE_LINK_3=
NEXT_PUBLIC_STRIPE_LINK_5=
NEXT_PUBLIC_STRIPE_LINK_10=
NEXT_PUBLIC_STRIPE_LINK_CUSTOM=
